# Образец Secret. Рабочий файл k8s/secret.yaml создаётся локально и в Git не попадает:
#   cp k8s/secret.yaml.example k8s/secret.yaml   — и задать свой пароль
# (kubectl apply -f k8s/ читает только *.yaml/*.yml/*.json, поэтому сам образец не применяется)
apiVersion: v1
kind: Secret
metadata:
  name: calculator-secret
  namespace: calculator
  labels:
    app.kubernetes.io/name: calculator
type: Opaque
stringData:
  STATUS_PASSWORD: "change-me"
