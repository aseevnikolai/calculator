# Образец настроек. Скопируйте: cp .env.example .env — и задайте свои значения.
# Файл .env в Git не попадает (см. .gitignore): реальные пароли храните только в нём.

# Порт на компьютере, на котором открывается приложение
WEB_PORT=8080
# Порт, который nginx слушает внутри контейнера
NGINX_PORT=8080
# Метка окружения — отдаётся в заголовке ответа X-App-Env
APP_ENV=development
# Вход на служебную страницу /status (статистика nginx)
STATUS_USER=admin
STATUS_PASSWORD=change-me
