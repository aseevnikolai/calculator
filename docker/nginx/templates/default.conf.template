server {
    listen       ${NGINX_PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # В каком окружении запущено приложение (переменная APP_ENV)
    add_header X-App-Env "${APP_ENV}" always;

    location / {
        try_files $uri $uri/ =404;
    }

    # Служебная статистика nginx; логин и пароль — из переменных окружения
    location = /status {
        auth_basic           "status";
        auth_basic_user_file /etc/nginx/conf.d/status.htpasswd;
        stub_status;
    }
}
